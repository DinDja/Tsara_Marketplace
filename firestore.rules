rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNÇÕES AUXILIARES
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // PRODUTOS - leitura pública, escrita admin
    // ==========================================

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      // Qualquer usuário autenticado pode atualizar rating/reviews (agregados de avaliações)
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviews', 'updatedAt']);
    }

    // ==========================================
    // CONSULTAS/CONSULTATION TYPES - leitura pública
    // ==========================================

    match /consultations/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // AGENDAMENTOS
    // ==========================================

    match /appointments/{appointmentId} {
      // Cliente autenticado pode ver seus próprios agendamentos
      // Admin pode ver todos
      allow read: if isAdmin()
        || (isAuthenticated()
            && resource.data.clientId == request.auth.uid);

      // Cliente autenticado pode criar (próprio clientId)
      allow create: if isAuthenticated()
        && request.resource.data.clientId == request.auth.uid;

      // Admin pode atualizar qualquer um
      // Cliente pode atualizar apenas o próprio (ex: cancelar)
      allow update: if isAdmin()
        || (isAuthenticated()
            && resource.data.clientId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'notes']));

      allow delete: if isAdmin();
    }

    // ==========================================
    // CLIENTES
    // ==========================================

    match /clients/{clientId} {
      // Cliente vê apenas seus próprios dados
      // Admin vê todos
      allow read: if isAdmin()
        || (isAuthenticated() && clientId == request.auth.uid);

      // Cliente pode criar próprio perfil
      allow create: if isAuthenticated()
        && clientId == request.auth.uid;

      // Proprietário ou admin pode atualizar
      allow update: if isAdmin()
        || (isAuthenticated() && clientId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // ==========================================
    // PEDIDOS
    // ==========================================

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isAuthenticated()
            && resource.data.clientId == request.auth.uid);

      allow create: if isAuthenticated()
        && request.resource.data.clientId == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ==========================================
    // CUPONS DE DESCONTO
    // ==========================================

    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // AVALIAÇÕES DE PRODUTOS
    // ==========================================

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // USUÁRIOS
    // ==========================================

    match /users/{userId} {
      // Próprio usuário ou admin pode ler
      allow read: if isAuthenticated()
        && (userId == request.auth.uid || isAdmin());

      // Usuário cria próprio perfil no registro
      allow create: if isAuthenticated()
        && userId == request.auth.uid;

      // Próprio usuário ou admin pode atualizar
      allow update: if isAdmin()
        || (isAuthenticated() && userId == request.auth.uid
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])));

      // Apenas admin pode mudar role
      allow delete: if isAdmin();
    }

    // ==========================================
    // NEGAÇÃO PADRÃO
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
